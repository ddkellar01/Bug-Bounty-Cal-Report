def calculate_cvss(vector_string: str):
    """Calculates CVSS 3.1 base score from vector string."""
    parts = vector_string.replace("CVSS:3.1/", "").split("/")
    metrics = {}
    for part in parts:
        if ":" in part:
            k, v = part.split(":")
            metrics[k] = v

    # Simplified deterministic CVSS 3.1 score mapping for demo
    c_impact = 0.56 if metrics.get("C") == "H" else 0.22
    i_impact = 0.56 if metrics.get("I") == "H" else 0.22
    iss = 1.0 - ((1.0 - c_impact) * (1.0 - i_impact))
    impact = 6.42 * iss
    exploitability = 8.22 * 0.85 * 0.77 * 0.62 * 0.85
    
    score = min(round(impact + exploitability, 1), 10.0)
    severity = "Critical" if score >= 9.0 else "High" if score >= 7.0 else "Medium" if score >= 4.0 else "Low"
    return score, severity
